[Unit]
Description=ICT Toolkit FCC failure notification (%i)
After=docker.service

[Service]
Type=oneshot
User=@DEPLOY_USER@
Group=@DEPLOY_GROUP@
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/lib/ict-toolkit-fcc-sync.py --config /etc/ict-toolkit-fcc.json --job-name %i --notify-failure
TimeoutStartSec=2min
NoNewPrivileges=yes
PrivateTmp=yes
