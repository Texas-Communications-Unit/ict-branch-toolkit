# Development values only. Replace every secret before any shared deployment.
DJANGO_SECRET_KEY=change-me-for-local-development
ICT_INVENTORY_ENCRYPTION_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_ENABLE_GIS=true
DJANGO_FORCE_HTTPS=false
DJANGO_HSTS_SECONDS=31536000
DJANGO_THROTTLE_ANON_RATE=30/min
DJANGO_THROTTLE_USER_RATE=300/min
DJANGO_THROTTLE_AUTH_RATE=10/min
DATABASE_URL=postgis://ict_toolkit:local-only-password@db:5432/ict_toolkit
POSTGRES_DB=ict_toolkit
POSTGRES_USER=ict_toolkit
POSTGRES_PASSWORD=local-only-password
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.invalid
DJANGO_SUPERUSER_PASSWORD=change-me-before-use
VITE_API_BASE_URL=http://localhost:8000
VITE_MAP_STYLE_URL=
VITE_MAP_TILE_URL=
VITE_MAP_PROVIDER_ID=
VITE_MAP_PROVIDER_NAME=
VITE_MAP_ATTRIBUTION_TEXT=
VITE_MAP_ATTRIBUTION_URL=
VITE_MAP_LICENSE_NAME=
VITE_MAP_LICENSE_URL=
VITE_MAP_TERMS_URL=
VITE_MAP_PRIVACY_URL=
VITE_MAP_REPORT_ISSUE_URL=
VITE_MAP_CONTACT_URL=
ICT_IDENTITY_PROVIDER=local
# External identity remains fail-closed until an approved authorization-code provider,
# exact role mapping, threat model, and deployment configuration are supplied.
ICT_EXTERNAL_SSO_ENABLED=false
ICT_EXTERNAL_IDENTITY_PROVIDER=apps.accounts.external_identity.DisabledExternalIdentityProvider
ICT_EXTERNAL_ROLE_MAPPINGS={}
ICT_EXTERNAL_ELIGIBILITY_GROUP=ICT Branch Toolkit — Access
ICT_EXTERNAL_ROLE_FIELD=ICT Branch Toolkit Role
ICT_EXTERNAL_IDENTITY_REFRESH_SECONDS=900
ICT_EXTERNAL_OUTAGE_GRACE_SECONDS=14400
ICT_TOKEN_TTL_SECONDS=43200
ICT_PUBLIC_BASE_URL=http://localhost:5173
ICT_EMAIL_ENABLED=false
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=localhost
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_USE_SSL=false
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=ICT Branch Toolkit <no-reply@example.invalid>
DJANGO_PASSWORD_RESET_TIMEOUT_SECONDS=3600
ICT_ROLE_POLICY_OVERRIDES={}
# Online-only collaboration: clients should heartbeat more frequently than this lease.
ICT_COLLABORATION_PRESENCE_TTL_SECONDS=75
ICT_COLLABORATION_HISTORY_LIMIT=100
# Default ICS-205 restricted-contact policy approved for Issue #23.
ICT_RESTRICTED_FIELD_DEFAULT_VIEW_ROLES=["administrator","coml","comc","comt"]
ICT_RESTRICTED_FIELD_DEFAULT_EDIT_ROLES=["administrator","coml","comc","comt"]
ICT_APPROVED_REFERENCE_IMPORTS=[]
ICT_GEOCODER_PROVIDER=apps.sites.geocoders.DisabledGeocoder
ICT_ELEVATION_PROVIDER=apps.rf_analysis.elevation.DisabledElevationProvider
ICT_APPROVED_ELEVATION_SOURCES=[]
ICT_ELEVATION_CACHE_TTL_SECONDS=604800
# Synthetic fixture modes are flat, slope, rugged, missing, boundary, out_of_coverage, datum,
# and the test-only failure path.
# The synthetic provider must be explicitly selected and allowlisted; it is never actual terrain.
ICT_SYNTHETIC_ELEVATION_MODE=flat
# Replaceable P2.3 planning-estimate engine. The shipped implementation and defaults are
# provisional, synthetic-evaluation-only decision support pending qualified practitioner review.
ICT_COVERAGE_ENGINE=apps.rf_analysis.coverage.ProvisionalFsplHorizonEngine
# JSON object keyed by local preset name. Every behavior change requires a new preset version.
ICT_COVERAGE_PRESETS={}
# Exact engine/preset versions approved through the qualified human gate. Empty fails closed.
ICT_APPROVED_COVERAGE_CONFIGURATIONS=[]
# Exact P2.4 probable-two-way rules approved through the qualified human gate. Empty fails closed.
ICT_APPROVED_DIRECTIONAL_RULES=[]
ICT_APPROVED_CALIBRATION_METHODS=[]
# Exact Phase 2 evidence profile approved by qualified RF/GIS, security/privacy,
# and maintainer review. Empty fails closed and prevents bundle approval/export.
ICT_APPROVED_PHASE2_VALIDATION_PROFILES=[]
# Exact RF deconfliction rule-set versions accepted by qualified practitioners and validated in
# the integrated test environment. Empty fails closed for analysis approval.
ICT_APPROVED_DECONFLICTION_RULESETS=[]
# Optional P3.1 terrain provider and sampled line-of-sight engine. Both remain
# fail-closed until the exact source/dataset/engine versions are allowlisted.
ICT_TERRAIN_PROVIDER=apps.rf_analysis.terrain.DisabledTerrainProfileProvider
ICT_TERRAIN_ENGINE=apps.rf_analysis.terrain.ProvisionalSampledLineOfSightEngine
ICT_APPROVED_TERRAIN_CONFIGURATIONS=[]
# Synthetic-only test modes: flat, ridge, valley, missing, boundary,
# out_of_coverage, datum, and failure.
ICT_SYNTHETIC_TERRAIN_MODE=flat
ICT_TERRAIN_MAX_DISTANCE_M=200000
ICT_TERRAIN_MAX_SAMPLES=1001
# Synthetic contract only. Setting this true does not enable live transport.
RADIOREFERENCE_ENABLED=false
RADIOREFERENCE_WSDL_URL=https://api.radioreference.com/soap2/?wsdl&v=latest
RADIOREFERENCE_MAX_RESPONSE_BYTES=1048576
