# Development values only. Replace every secret before any shared deployment.
DJANGO_SECRET_KEY=change-me-for-local-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_ENABLE_GIS=true
DJANGO_FORCE_HTTPS=false
DJANGO_HSTS_SECONDS=31536000
DJANGO_THROTTLE_ANON_RATE=30/min
DJANGO_THROTTLE_USER_RATE=300/min
DJANGO_THROTTLE_AUTH_RATE=10/min
DATABASE_URL=postgis://ict_toolkit:local-only-password@db:5432/ict_toolkit
POSTGRES_DB=ict_toolkit
POSTGRES_USER=ict_toolkit
POSTGRES_PASSWORD=local-only-password
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.invalid
DJANGO_SUPERUSER_PASSWORD=change-me-before-use
VITE_API_BASE_URL=http://localhost:8000
VITE_MAP_STYLE_URL=
VITE_MAP_TILE_URL=
VITE_MAP_PROVIDER_ID=
VITE_MAP_PROVIDER_NAME=
VITE_MAP_ATTRIBUTION_TEXT=
VITE_MAP_ATTRIBUTION_URL=
VITE_MAP_LICENSE_NAME=
VITE_MAP_LICENSE_URL=
VITE_MAP_TERMS_URL=
VITE_MAP_PRIVACY_URL=
VITE_MAP_REPORT_ISSUE_URL=
VITE_MAP_CONTACT_URL=
ICT_IDENTITY_PROVIDER=local
ICT_TOKEN_TTL_SECONDS=28800
ICT_ROLE_POLICY_OVERRIDES={}
ICT_APPROVED_REFERENCE_IMPORTS=[]
ICT_GEOCODER_PROVIDER=apps.sites.geocoders.DisabledGeocoder
ICT_ELEVATION_PROVIDER=apps.rf_analysis.elevation.DisabledElevationProvider
ICT_APPROVED_ELEVATION_SOURCES=[]
ICT_ELEVATION_CACHE_TTL_SECONDS=604800
# Synthetic fixture modes are flat, slope, rugged, missing, boundary, out_of_coverage, datum,
# and the test-only failure path.
# The synthetic provider must be explicitly selected and allowlisted; it is never actual terrain.
ICT_SYNTHETIC_ELEVATION_MODE=flat
# Replaceable P2.3 planning-estimate engine. The shipped implementation and defaults are
# provisional, synthetic-evaluation-only decision support pending qualified practitioner review.
ICT_COVERAGE_ENGINE=apps.rf_analysis.coverage.ProvisionalFsplHorizonEngine
# JSON object keyed by local preset name. Every behavior change requires a new preset version.
ICT_COVERAGE_PRESETS={}
# Exact engine/preset versions approved through the qualified human gate. Empty fails closed.
ICT_APPROVED_COVERAGE_CONFIGURATIONS=[]
# Exact P2.4 probable-two-way rules approved through the qualified human gate. Empty fails closed.
ICT_APPROVED_DIRECTIONAL_RULES=[]
